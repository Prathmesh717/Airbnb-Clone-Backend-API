# Local application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Prisma / PostgreSQL with PostGIS (docker-compose.yml defaults)
DATABASE_URL=postgresql://airbnb:airbnb@localhost:5432/airbnb?schema=public

# Native Redis is provided for local infrastructure. Set REDIS_URL for the Docker
# service, or use the Upstash REST pair for a serverless deployment.
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_TTL_SECONDS=60

# NextAuth / development auth
# Replace this value before deploying.
AUTH_SECRET=local-development-secret-change-me
NEXTAUTH_SECRET=local-development-secret-change-me
# Enables x-user-id / x-user-role headers for local API smoke tests only.
ALLOW_DEV_AUTH=true

# Optional OAuth providers. Leave blank to use credential login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Optional Stripe integration. Empty values keep payments on the mock provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional signed Cloudinary uploads for host listing media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
